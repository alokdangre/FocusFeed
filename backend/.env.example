# Copy this file to backend/.env and change values when needed.
# The local launcher loads backend/.env before starting the API.
# backend/.env is gitignored because TYPESAFE_API_KEY is a secret.

TYPESAFE_API_KEY=replace-with-your-server-side-key

# Pin the evaluated model. Changing this changes cache identity and requires
# re-running the reviewed objective and video evaluations.
TYPESAFE_MODEL=jev-1.13.0

# Optional System One endpoint override and HTTP timeout.
TYPESAFE_API_ENDPOINT=https://api.typesafe.ai/v1/systemone
TYPESAFE_TIMEOUT_SECONDS=20

# Raw video/topic probability cache; no titles/descriptions are stored.
FOCUSFEED_CACHE_ENABLED=true
# Optional: absolute SQLite path. Defaults to backend/.cache/judgments.sqlite3 locally.
# FOCUSFEED_CACHE_PATH=/absolute/path/judgments.sqlite3

# Hosted/default mode requires verified Cognito sessions and server-side access.
FOCUSFEED_AUTH_MODE=required
# Set these from the SAM outputs after deploying the Stage 1 infrastructure.
# FOCUSFEED_AUTH_ISSUER=https://cognito-idp.REGION.amazonaws.com/POOL_ID
# FOCUSFEED_AUTH_CLIENT_ID=PUBLIC_APP_CLIENT_ID
# FOCUSFEED_AUTH_DOMAIN=https://YOUR_DOMAIN.auth.REGION.amazoncognito.com
# FOCUSFEED_USER_TABLE=YOUR_USER_DATA_TABLE
# FOCUSFEED_ACCESS_TABLE=YOUR_READ_ONLY_ACCESS_TABLE
# FOCUSFEED_CONFIG_TABLE=YOUR_READ_ONLY_POLICY_TABLE
# FOCUSFEED_JOB_TABLE=YOUR_JOB_TABLE
# Explicit opt-in for the loopback-only development server with your own key:
# FOCUSFEED_AUTH_MODE=local
# Local mode is rejected in Lambda, even if configured accidentally.

# Optional Dodo staging integration. Never paste real keys into the extension.
# FOCUSFEED_BILLING_ENABLED=true
# FOCUSFEED_BILLING_MODE=test_mode
# FOCUSFEED_BILLING_TABLE=YOUR_BILLING_TABLE
# DODO_ENVIRONMENT=test_mode
# DODO_API_KEY=YOUR_TEST_MODE_MERCHANT_KEY
# DODO_WEBHOOK_SECRET=YOUR_TEST_MODE_WEBHOOK_SIGNING_SECRET
# DODO_BUSINESS_ID=YOUR_TEST_BUSINESS_ID
# DODO_PRO_PRODUCT_ID=YOUR_TEST_RECURRING_PRODUCT_ID
# DODO_LEGACY_PRODUCT_IDS=COMMA_SEPARATED_PREVIOUS_PRO_PRODUCTS
# DODO_RETURN_URL=https://YOUR_API_HOST/billing/return
