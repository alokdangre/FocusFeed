# Copy this file to backend/.env and change values when needed.
# The local launcher loads backend/.env before starting the API.
# backend/.env is gitignored because TYPESAFE_API_KEY is a secret.

TYPESAFE_API_KEY=replace-with-your-server-side-key

# Pin the evaluated model. Changing this changes cache identity and requires
# re-running the reviewed objective and video evaluations.
TYPESAFE_MODEL=jev-1.13.0

# Optional System One endpoint override and HTTP timeout.
TYPESAFE_API_ENDPOINT=https://api.typesafe.ai/v1/systemone
TYPESAFE_TIMEOUT_SECONDS=20

# Raw video/topic probability cache; no titles/descriptions are stored.
FOCUSFEED_CACHE_ENABLED=true
# Optional: absolute SQLite path. Defaults to backend/.cache/judgments.sqlite3 locally.
# FOCUSFEED_CACHE_PATH=/absolute/path/judgments.sqlite3
