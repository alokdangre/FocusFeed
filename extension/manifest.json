{
  "manifest_version": 3,
  "name": "FocusFeed",
  "version": "0.10.0",
  "description": "Confirm predefined topics, filter with observable Jev judgments, and approve channel blocks.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["page-gate.js", "interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["workflow-core.js", "channel-policy.js", "live/engine.js", "live/content.js", "content.js"],
      "world": "ISOLATED",
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FocusFeed"
  }
}
