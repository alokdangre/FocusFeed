{
  "manifest_version": 3,
  "name": "FocusFeed",
  "version": "0.24.0",
  "description": "Always-on YouTube topic filtering and channel blocking, with an optional Focus timer.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "*://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "page-gate.js",
        "interceptor.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "video-model.js",
        "channel-policy.js",
        "settings.js",
        "learning-policy.js",
        "auto-runtime.js",
        "home-feed.js",
        "preview-controller.js",
        "loading-ui.js",
        "topic-picker.js",
        "preferences-controller.js",
        "popup/topic-input.js",
        "youtube-preferences.js",
        "youtube-ui.js",
        "content.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_start",
      "css": [
        "youtube.css",
        "youtube-preferences.css"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FocusFeed"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
