# Copy this file to backend/.env and change values when needed.
# The local launcher loads this file before starting the API.

# Name of an AWS CLI profile configured in ~/.aws.
# Keep access keys and secret keys out of this file.
AWS_PROFILE=focusfeed

# Region used for Bedrock inference.
BEDROCK_REGION=us-east-1

# Bedrock inference profile used by the classifier.
BEDROCK_MODEL_ID=us.amazon.nova-micro-v1:0

